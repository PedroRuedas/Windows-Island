<Window x:Class="WindowsIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WindowsIsland.Controls"
        Title="Windows Island" Width="560" Height="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <!-- Glyphs outside Fluent Icons (like Claude's ✻) get Segoe UI Symbol in code: see GlyphFont. -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- Display cut for headings, the closest Windows match to SF Pro Display. -->
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="DimText" Color="#A6FFFFFF" />
        <SolidColorBrush x:Key="FaintText" Color="#61FFFFFF" />

        <!-- Filled transport symbols, drawn as vectors (in the spirit of SF Symbols play.fill, pause.fill, forward.fill). -->
        <Geometry x:Key="PlayGeometry">M 3,1.6 C 3,0.6 4.1,0 5,0.6 L 15.3,7.1 C 16.1,7.6 16.1,8.4 15.3,8.9 L 5,15.4 C 4.1,16 3,15.4 3,14.4 Z</Geometry>
        <GeometryGroup x:Key="PauseGeometry">
            <RectangleGeometry Rect="2.5,1,4.4,14" RadiusX="1.3" RadiusY="1.3" />
            <RectangleGeometry Rect="9.1,1,4.4,14" RadiusX="1.3" RadiusY="1.3" />
        </GeometryGroup>
        <Geometry x:Key="ForwardGeometry">M 0.5,1.9 C 0.5,1 1.5,0.5 2.2,1.1 L 8.4,6.1 C 9,6.6 9,7.4 8.4,7.9 L 2.2,12.9 C 1.5,13.5 0.5,13 0.5,12.1 Z M 9.3,1.9 C 9.3,1 10.3,0.5 11,1.1 L 17.2,6.1 C 17.8,6.6 17.8,7.4 17.2,7.9 L 11,12.9 C 10.3,13.5 9.3,13 9.3,12.1 Z</Geometry>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="22" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#17FFFFFF" />
                            </Trigger>
                            <!-- iOS-style press: the control shrinks a little under your finger. -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#29FFFFFF" />
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small text button (e.g. "Limpar"). -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DimText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="8,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS-style switch. -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="40" Height="24" CornerRadius="12" Background="#3A3A3C">
                            <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#30D158" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One option of an iOS-style segmented control. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource DimText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="7" Padding="12,4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#48484A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FaintText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>

        <!-- Clickable list row (Claude sessions, notifications). -->
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="-8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Root transform: the black-hole "swallow" animation scales and spins everything into the island's center. -->
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.047">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" />
                <RotateTransform x:Name="RootSpin" />
            </TransformGroup>
        </Grid.RenderTransform>
        <!-- ═════════════ The island ═════════════ -->
        <Border x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Width="140" Height="34" CornerRadius="17" Background="Black"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                MouseLeftButtonUp="Island_MouseLeftButtonUp" MouseWheel="Island_MouseWheel">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" RenderingBias="Performance" />
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu Opened="ContextMenu_Opened">
                    <MenuItem x:Name="NotificationsMenuItem" Header="Notificações do Windows" Click="NotificationsMenuItem_Click" />
                    <MenuItem x:Name="StartupMenuItem" Header="Iniciar com o Windows" IsCheckable="True" Click="StartupMenuItem_Click" />
                    <MenuItem x:Name="ApiMenuItem" Header="Copiar endereço da API" Click="ApiMenuItem_Click" />
                    <MenuItem Header="Ocultar ilha (buraco negro)" Click="HideMenuItem_Click" />
                    <MenuItem Header="Testar notificação" Click="TestMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="Sair" Click="ExitMenuItem_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <!-- Views are laid out at their final size and centered by code, so they get
                 "revealed" by the clip while the island springs open. -->
            <Canvas x:Name="Stage">

                <!-- IDLE: the resting pill -->
                <Grid x:Name="IdleView" Width="140" Height="34">
                    <TextBlock x:Name="IdleClock" Foreground="#8CFFFFFF" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- IDLE EXPANDED: clock + date -->
                <Grid x:Name="ClockView" Width="240" Height="84" Opacity="0" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="BigClock" FontSize="32" FontWeight="Light" FontFamily="{StaticResource DisplayFont}" Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DateText" FontSize="12" Foreground="{StaticResource DimText}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- COMPACT: [badge] title/level ... [equalizer|value] -->
                <Grid x:Name="CompactView" Width="320" Height="38" Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CompactBadge" Width="26" Height="26" CornerRadius="13" Margin="7,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactIcon" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="CompactIconSpin" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <Grid Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactTitle" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <ui:LevelBar x:Name="CompactLevel" Height="5" Visibility="Collapsed" />
                    </Grid>
                    <Grid Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center">
                        <StackPanel x:Name="CompactEqualizer" Orientation="Horizontal" Height="16" Visibility="Collapsed" />
                        <TextBlock x:Name="CompactValue" Foreground="#CCFFFFFF" FontSize="12" FontWeight="SemiBold" />
                    </Grid>
                </Grid>

                <!-- MEDIA EXPANDED -->
                <Grid x:Name="MediaView" Width="400" Opacity="0" IsHitTestVisible="False">
                    <Grid Margin="22,20,22,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- YouTube: the video itself, mirrored from the browser (muted, in sync). Clipped to rounded corners in code. -->
                        <Border x:Name="VideoHost" Width="356" Height="200" Background="#0DFFFFFF" Margin="0,0,0,14" Visibility="Collapsed" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MediaArt" Width="62" Height="62" CornerRadius="15" Background="#1FFFFFFF">
                                <!-- Soft glow in the artwork color, like the iOS player. -->
                                <Border.Effect>
                                    <DropShadowEffect x:Name="MediaArtGlow" BlurRadius="30" ShadowDepth="0" Opacity="0.55" Color="Black" RenderingBias="Performance" />
                                </Border.Effect>
                                <TextBlock x:Name="MediaArtIcon" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{StaticResource DimText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE8D6;" />
                            </Border>
                            <StackPanel x:Name="MediaTexts" Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MediaTitle" Foreground="White" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaArtist" Foreground="{StaticResource DimText}" FontSize="13.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaSource" Foreground="{StaticResource FaintText}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel x:Name="MediaEqualizer" Grid.Column="2" Orientation="Horizontal" Height="20" VerticalAlignment="Center" />
                        </Grid>

                        <Grid x:Name="MediaTimeline" Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MediaPosition" Foreground="{StaticResource DimText}" FontSize="11" VerticalAlignment="Center" />
                            <!-- Taller transparent hit area so the 5px bar is easy to click for seeking. -->
                            <Border Grid.Column="1" Height="18" Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="MediaSeek_MouseLeftButtonDown">
                                <ui:LevelBar x:Name="MediaProgress" Height="4.5" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="MediaDuration" Grid.Column="2" Foreground="{StaticResource DimText}" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Style="{StaticResource IconButton}" Click="PreviousButton_Click" Margin="10,0">
                                <!-- backward.fill = forward.fill mirrored -->
                                <Path Data="{StaticResource ForwardGeometry}" Fill="White" Width="25" Height="19" Stretch="Uniform"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Width="54" Height="54" Margin="10,0"
                                    Click="PlayPauseButton_Click">
                                <Path x:Name="PlayPauseIcon" Data="{StaticResource PlayGeometry}" Fill="White" Width="24" Height="24" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="NextButton_Click" Margin="10,0">
                                <Path Data="{StaticResource ForwardGeometry}" Fill="White" Width="25" Height="19" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ACTIVITY EXPANDED (alerts, downloads, timers...) -->
                <Grid x:Name="ActivityView" Width="400" Opacity="0" IsHitTestVisible="False">
                    <Grid Margin="18,16,22,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ActivityBadge" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top">
                            <TextBlock x:Name="ActivityIcon" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ActivityCaption" Foreground="{StaticResource FaintText}" FontSize="11" FontWeight="SemiBold"
                                       Margin="0,0,0,1" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                            <TextBlock x:Name="ActivityTitle" Foreground="White" FontSize="15.5" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ActivitySubtitle" Foreground="{StaticResource DimText}" FontSize="13" Margin="0,2,0,0"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" />
                            <Grid x:Name="ActivityProgressRow" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:LevelBar x:Name="ActivityProgress" Height="5" VerticalAlignment="Center" />
                                <TextBlock x:Name="ActivityProgressText" Grid.Column="1" Margin="10,0,0,0" Foreground="{StaticResource DimText}"
                                           FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- CLAUDE CODE: sessions per project + token usage -->
                <Grid x:Name="ClaudeView" Width="400" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Margin="22,18,22,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClaudeHeaderIcon" FontFamily="Segoe UI Symbol" FontSize="18" Foreground="#D97757"
                                       VerticalAlignment="Center" Text="&#x273B;" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="ClaudeHeaderSpin" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="Claude Code" Foreground="White" FontSize="15.5" FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ClaudeSummary" Grid.Column="2" Foreground="{StaticResource DimText}" FontSize="12" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel x:Name="ClaudeSessions" Margin="0,8,0,0" />

                        <Border Height="1" Background="#1AFFFFFF" Margin="0,8,0,10" />

                        <!-- Usage from the local transcripts: today, the last 7 days and the last 5 hours. -->
                        <Grid x:Name="ClaudeUsageRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Hoje" Foreground="{StaticResource FaintText}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="UsageToday" Foreground="White" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,1,0,0" />
                                <TextBlock x:Name="UsageTodaySub" Foreground="{StaticResource FaintText}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Últimos 7 dias" Foreground="{StaticResource FaintText}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="UsageWeek" Foreground="White" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,1,0,0" />
                                <TextBlock x:Name="UsageWeekSub" Foreground="{StaticResource FaintText}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Últimas 5h" Foreground="{StaticResource FaintText}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="UsageRecent" Foreground="White" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,1,0,0" />
                                <TextBlock Text="tokens" Foreground="{StaticResource FaintText}" FontSize="11" />
                            </StackPanel>
                        </Grid>

                        <!-- Tokens per day, one bar per day (built in code). -->
                        <Grid x:Name="UsageChart" Height="62" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
                <!-- NOTIFICATIONS: recent history (WhatsApp, Teams...) -->
                <Grid x:Name="NotificationsView" Width="400" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Margin="22,16,22,10">
                        <Grid>
                            <TextBlock Text="Notificações" Foreground="White" FontSize="15.5" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource TextButton}" Content="Limpar" HorizontalAlignment="Right" Click="ClearNotifications_Click" />
                        </Grid>
                        <StackPanel x:Name="NotificationList" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <!-- SETTINGS: opened from the gear in the tab bar -->
                <Grid x:Name="SettingsView" Width="400" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Margin="22,18,22,10">
                        <Grid>
                            <TextBlock Text="Personalizar" Foreground="White" FontSize="15.5" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
                            <TextBlock x:Name="BorderName" Foreground="{StaticResource DimText}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="BORDA" Style="{StaticResource SectionLabel}" />
                        <WrapPanel x:Name="PresetSwatches" />

                        <StackPanel x:Name="CustomColorsPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Cor inicial" Style="{StaticResource SettingLabel}" Foreground="{StaticResource DimText}" FontSize="12" />
                                <WrapPanel x:Name="CustomColor1" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Cor final" Style="{StaticResource SettingLabel}" Foreground="{StaticResource DimText}" FontSize="12" />
                                <WrapPanel x:Name="CustomColor2" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="Espessura" Style="{StaticResource SettingLabel}" />
                            <Border Background="#1C1C1E" CornerRadius="9" Padding="2" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThinBorder" Style="{StaticResource Segment}" GroupName="Thickness" Content="Fina" Tag="1" Checked="Thickness_Checked" />
                                    <RadioButton x:Name="MediumBorder" Style="{StaticResource Segment}" GroupName="Thickness" Content="Média" Tag="2" Checked="Thickness_Checked" />
                                    <RadioButton x:Name="ThickBorder" Style="{StaticResource Segment}" GroupName="Thickness" Content="Grossa" Tag="3" Checked="Thickness_Checked" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Degradê em movimento" Style="{StaticResource SettingLabel}" />
                            <CheckBox x:Name="AnimateToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="SettingToggle_Click" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Brilho na borda" Style="{StaticResource SettingLabel}" />
                            <CheckBox x:Name="GlowToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="SettingToggle_Click" />
                        </Grid>

                        <TextBlock Text="ILHA" Style="{StaticResource SectionLabel}" Margin="0,18,0,4" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="Relógio na ilha em repouso" Style="{StaticResource SettingLabel}" />
                            <CheckBox x:Name="ClockToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="SettingToggle_Click" />
                        </Grid>
                        <Grid Margin="0,12,0,4">
                            <TextBlock Text="Iniciar com o Windows" Style="{StaticResource SettingLabel}" />
                            <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="SettingToggle_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Page tabs at the bottom of the expanded island: switch between apps -->                <StackPanel x:Name="PagerBar" Orientation="Horizontal" Height="30" Opacity="0" IsHitTestVisible="False" />
            </Canvas>
        </Border>

        <!-- Hairline rim: keeps the black island readable on dark apps (sized with the island in code). -->
        <Border x:Name="IslandRim" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Width="140" Height="34" CornerRadius="17" BorderThickness="1" BorderBrush="#17FFFFFF" IsHitTestVisible="False" />

        <!-- ═════════════ Split island: a second live activity next to the main pill ═════════════ -->
        <Border x:Name="Bubble" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Width="34" Height="34" CornerRadius="17" Background="Black" Opacity="0" IsHitTestVisible="False"
                Cursor="Hand" MouseLeftButtonUp="Bubble_MouseLeftButtonUp" RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" RenderingBias="Performance" />
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale" ScaleX="0" ScaleY="0" />
                    <TranslateTransform x:Name="BubbleShift" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Border x:Name="BubbleBadge" Width="24" Height="24" CornerRadius="12">
                <TextBlock x:Name="BubbleIcon" FontFamily="{StaticResource IconFont}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="BubbleIconSpin" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Border>
                <Border x:Name="BubbleRim" CornerRadius="17" BorderThickness="1" BorderBrush="#17FFFFFF" IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
