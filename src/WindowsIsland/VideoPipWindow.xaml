<Window x:Class="WindowsIsland.VideoPipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WindowsIsland.Controls"
        Title="Windows Island · Vídeo"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <!-- Round translucent button over the video. -->
        <Style x:Key="PipButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#73000000" CornerRadius="15" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#CC2C2C2E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the drop shadow around the video. -->
    <Grid x:Name="Root" Margin="14" Opacity="0" RenderTransformOrigin="0.5,0.5"
          MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.9" ScaleY="0.9" />
        </Grid.RenderTransform>

        <!-- Static shadow plate behind the video: keeping the effect off the video's own subtree keeps it cheap. -->
        <Border CornerRadius="14" Background="Black">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.5" Color="Black" RenderingBias="Performance" />
            </Border.Effect>
        </Border>

        <!-- Rounded corners are clipped in code. Dragging anywhere that isn't a control moves the window. -->
        <Grid x:Name="Surface" Background="Black"
              MouseLeftButtonDown="Surface_MouseLeftButtonDown" MouseWheel="Surface_MouseWheel">
            <Border x:Name="VideoHost" />

            <!-- While the player loads, or with no identifiable video (an ad...): show the artwork instead of black. -->
            <Grid x:Name="Placeholder" Background="Black">
                <Image x:Name="PlaceholderArt" Stretch="UniformToFill" Opacity="0.35" />
                <StackPanel VerticalAlignment="Center" Margin="24,0">
                    <TextBlock x:Name="PlaceholderTitle" Foreground="White" FontSize="14" FontWeight="SemiBold"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PlaceholderHint" Foreground="{StaticResource DimText}" FontSize="12" Margin="0,4,0,0"
                               TextAlignment="Center" Text="Carregando o vídeo…" />
                </StackPanel>
            </Grid>

            <!-- Controls fade in on hover, over soft scrims so they read on any frame. -->
            <Grid x:Name="ControlsLayer" Opacity="0" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="3" Height="70" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#A6000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border Grid.RowSpan="3" Height="76" VerticalAlignment="Bottom" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#BF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="8,8,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource PipButton}" Content="&#xE73F;" Click="Return_Click" ToolTip="Voltar para a ilha" />
                    <TextBlock x:Name="TitleText" Grid.Column="1" Foreground="White" FontSize="12.5" FontWeight="SemiBold" Margin="10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                    <Button Grid.Column="2" Style="{StaticResource PipButton}" Content="&#xE8BB;" FontSize="10" Click="Close_Click" ToolTip="Fechar" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource PipButton}" Width="40" Height="40" Margin="8,0" Click="Previous_Click">
                        <Path Data="{StaticResource ForwardGeometry}" Fill="White" Width="18" Height="14" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource PipButton}" Width="50" Height="50" Margin="8,0" Click="PlayPause_Click">
                        <Path x:Name="PlayPauseIcon" Data="{StaticResource PlayGeometry}" Fill="White" Width="19" Height="19" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource PipButton}" Width="40" Height="40" Margin="8,0" Click="Next_Click">
                        <Path Data="{StaticResource ForwardGeometry}" Fill="White" Width="18" Height="14" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <Grid x:Name="Timeline" Grid.Row="2" Margin="12,0,26,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText" Style="{StaticResource TimeText}" />
                    <!-- Taller transparent hit area so the thin bar is easy to click for seeking. -->
                    <Border Grid.Column="1" Height="16" Margin="8,0" Background="Transparent" Cursor="Hand"
                            MouseLeftButtonDown="Seek_MouseLeftButtonDown">
                        <ui:LevelBar x:Name="Progress" Height="4" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="DurationText" Grid.Column="2" Style="{StaticResource TimeText}" />
                </Grid>
            </Grid>

            <!-- Resize from the corner (the mouse wheel resizes too). -->
            <Border x:Name="Grip" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="Transparent" Cursor="SizeNWSE" Opacity="0"
                    MouseLeftButtonDown="Grip_MouseLeftButtonDown" MouseMove="Grip_MouseMove" MouseLeftButtonUp="Grip_MouseLeftButtonUp">
                <Path Data="M 12,2 L 2,12 M 12,7 L 7,12" Stroke="White" StrokeThickness="1.5" Opacity="0.85"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" />
            </Border>
        </Grid>
    </Grid>
</Window>
