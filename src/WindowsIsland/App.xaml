<Application x:Class="WindowsIsland.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <!-- Shared by the island and the pinned video window. -->
    <Application.Resources>
        <!-- Glyphs outside Fluent Icons (like Claude's ✻) get Segoe UI Symbol in code: see GlyphFont. -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- Display cut for headings, the closest Windows match to SF Pro Display. -->
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="DimText" Color="#A6FFFFFF" />
        <SolidColorBrush x:Key="FaintText" Color="#61FFFFFF" />

        <!-- Filled transport symbols, drawn as vectors (in the spirit of SF Symbols play.fill, pause.fill, forward.fill). -->
        <Geometry x:Key="PlayGeometry">M 3,1.6 C 3,0.6 4.1,0 5,0.6 L 15.3,7.1 C 16.1,7.6 16.1,8.4 15.3,8.9 L 5,15.4 C 4.1,16 3,15.4 3,14.4 Z</Geometry>
        <GeometryGroup x:Key="PauseGeometry">
            <RectangleGeometry Rect="2.5,1,4.4,14" RadiusX="1.3" RadiusY="1.3" />
            <RectangleGeometry Rect="9.1,1,4.4,14" RadiusX="1.3" RadiusY="1.3" />
        </GeometryGroup>
        <Geometry x:Key="ForwardGeometry">M 0.5,1.9 C 0.5,1 1.5,0.5 2.2,1.1 L 8.4,6.1 C 9,6.6 9,7.4 8.4,7.9 L 2.2,12.9 C 1.5,13.5 0.5,13 0.5,12.1 Z M 9.3,1.9 C 9.3,1 10.3,0.5 11,1.1 L 17.2,6.1 C 17.8,6.6 17.8,7.4 17.2,7.9 L 11,12.9 C 10.3,13.5 9.3,13 9.3,12.1 Z</Geometry>
    </Application.Resources>
</Application>
